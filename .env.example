# ─── Core ────────────────────────────────────────────────────────────────────
# Neon PostgreSQL (production). Format:
# postgresql://user:password@ep-xxx.region.aws.neon.tech:5432/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech:5432/billing?sslmode=require"

# Secret used to sign session JWTs (min 32 chars). Generate: openssl rand -hex 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Shared secret required by /api/cron/daily (header: x-cron-secret)
CRON_SECRET="change-me-cron-secret"

# Public base URL of this portal (used in emails / magic links)
NEXT_PUBLIC_APP_URL="https://osiris-center-xxxxx-uc.a.run.app"

# Run the scheduler inside the Next.js server process (self-hosted deploys)
ENABLE_IN_SERVER_CRON="false"

# Enable /api/dev/outbox viewer (auto-on in development)
ENABLE_DEV_TOOLS="false"

# ─── GCash QR (choose one provider) ──────────────────────────────────────────
# static  -> custom dynamic QR display + manual reference entry (no keys needed)
# xendit  -> Xendit QR Code API (real dynamic GCash QR)
# paymongo-> PayMongo GCash e-wallet source (checkout flow)
GCASH_PROVIDER="static"
GCASH_STATIC_NUMBER="09171234567"
GCASH_STATIC_NAME="OSIRIS CENTER Digital Services"
# Dev convenience: auto-approve manually-entered static-QR references
AUTO_CONFIRM_STATIC_QR="false"

XENDIT_API_KEY=""
XENDIT_CALLBACK_TOKEN=""
XENDIT_API_BASE="https://api.xendit.co"

PAYMONGO_SECRET_KEY=""
PAYMONGO_WEBHOOK_SECRET=""

# ─── PayPal (Orders v2 REST) ─────────────────────────────────────────────────
PAYPAL_ENV="sandbox"                 # sandbox | live
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""                 # required to cryptographically verify webhooks
PAYPAL_CURRENCY="PHP"
# Client-side SDK (browser) — needed for the PayPal tab in the payment modal
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""

# ─── Email (log = dev outbox) ────────────────────────────────────────────────
EMAIL_PROVIDER="log"                 # log | resend | sendgrid
EMAIL_FROM="Billing <billing@yourdomain.com>"
RESEND_API_KEY=""
SENDGRID_API_KEY=""

# ─── SMS (log = dev outbox) ──────────────────────────────────────────────────
SMS_PROVIDER="log"                   # log | semaphore
SEMAPHORE_API_KEY=""
SEMAPHORE_SENDER_NAME="OSIRIS CENTER"

# ─── Provisioning API seed key (hashed into DB on first seed) ────────────────
PROVISIONING_SEED_KEY="pk_demo_change_me"
